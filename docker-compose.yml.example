version: '3.8'

services:
  openlist-bot:
    # 从 GitHub Container Registry 自动拉取镜像
    image: ghcr.io/gm-aaa/openlist-bot:latest
    container_name: openlist-bot
    restart: unless-stopped

    # 启用 web 后，配置文件中的 web.bind 应为 0.0.0.0:8080。
    # 默认仅供宿主机反向代理访问；需要直接内网访问时再调整宿主机绑定地址。
    # ports:
    #   - "127.0.0.1:8080:8080"
    
    # 如果您想使用本地源码构建，可以取消注释下方 build 部分并注释掉 image 字段：
    # build:
    #   context: .
    #   dockerfile: Dockerfile

    volumes:
      # 配置管理功能需要写回此文件，因此必须以读写模式挂载
      - ./config.yaml:/app/config.yaml
      
      # 挂载数据目录，持久化保存种子缓存和内部数据状态
      - ./data:/app/data
      
      # 挂载日志目录
      - ./logs:/app/logs

    # 配置日志记录以防日志占满硬盘
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
